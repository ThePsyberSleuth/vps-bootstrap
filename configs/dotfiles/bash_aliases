# ==============================================================================
# Shell Aliases & Productivity Helpers
# ==============================================================================

# Directory Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# File System (eza)
if command -v eza &> /dev/null; then
  alias ls="eza -lh --group-directories-first --icons=auto"
  alias lsa="ls -a"
  alias lt="eza --tree --level=2 --long --icons --git"
  alias lta="lt -a"
  alias l="eza -lah --group-directories-first --icons=auto"
  alias ll="eza -lh --group-directories-first --icons=auto"
  alias la="eza -a --group-directories-first --icons=auto"
fi

# Bat / Cat
if command -v bat &> /dev/null; then
  alias cat="bat --paging=never"
fi

# FZF + Bat file finder
if command -v fzf &> /dev/null && command -v bat &> /dev/null; then
  alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
  alias eff='$EDITOR "$(ff)"'
  sff() { if [ $# -eq 0 ]; then echo "Usage: sff <destination> (e.g. sff host:/tmp/)"; return 1; fi; local file; file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | ff) && [ -n "$file" ] && scp "$file" "$1"; }
fi

# Zoxide smart directory switching
if command -v zoxide &> /dev/null; then
  alias cd="zd"
  zd() {
    if (( $# == 0 )); then
      builtin cd ~ || return
    elif [[ -d $1 ]]; then
      builtin cd "$1" || return
    else
      if ! z "$@"; then
        echo "Error: Directory not found"
        return 1
      fi
      printf "\U000F17A9 "
      pwd
    fi
  }
fi

# Git shortcuts
alias g="git"
alias gcm="git commit -m"
alias gcam="git commit -a -m"
alias gcad="git commit -a --amend"
alias lg="lazygit"

# Git Worktree helpers (ga = add worktree, gd = remove worktree)
ga() {
  if [[ -z "$1" ]]; then
    echo "Usage: ga [branch name]"
    return 1
  fi
  local branch="$1"
  local base="$(basename "$PWD")"
  local wt_path="../${base}--${branch}"
  git worktree add -b "$branch" "$wt_path"
  command -v mise &>/dev/null && mise trust "$wt_path" 2>/dev/null || true
  cd "$wt_path"
}

gd() {
  local cwd base branch root worktree
  cwd="$(pwd)"
  worktree="$(basename "$cwd")"
  root="${worktree%%--*}"
  branch="${worktree#*--}"
  if [[ "$root" != "$worktree" ]]; then
    cd "../$root"
    git worktree remove "$cwd" --force || return 1
    git branch -D "$branch"
  else
    echo "Error: Not currently inside a recognized worktree (-- delimiter)."
  fi
}

